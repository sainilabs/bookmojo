---
import App from '@/App';
import ThemeHead from '@/components/ui/ThemeHead.astro';
import '@/styles/global.css';
import { FAQS } from '@/data/faq';

const title = 'BookMojo — Personalised Storybooks Where Your Child Is the Hero';
const description =
  "The gift where your child is the hero: personalised storybooks built around their name, age and dream career, in English or Hindi. Order on WhatsApp.";
const canonical = new URL(Astro.url.pathname, Astro.site);
const asset = (path: string) => `${import.meta.env.BASE_URL}${path}`;

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'BookMojo Personalised Storybook',
  description,
  image: new URL(asset('hero-book.webp'), Astro.site).href,
  brand: { '@type': 'Brand', name: 'BookMojo' },
  inLanguage: ['en-IN', 'hi-IN'],
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'INR',
    lowPrice: '199',
    highPrice: '1499',
    offerCount: '2',
    availability: 'https://schema.org/InStock',
    areaServed: { '@type': 'Country', name: 'India' },
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<!doctype html>
<html lang="en-IN" data-theme="day">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <ThemeHead />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BookMojo" />
    <meta property="og:title" content="The gift where your child is the hero" />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(asset('og.svg'), Astro.site)} />
    <meta property="og:image:alt" content="BookMojo personalised storybooks" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={asset('favicon.svg')} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(productSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>
  <body>
    <App client:load />
    <noscript>
      <div style="padding: 2rem; font-family: sans-serif">
        <h1>BookMojo</h1>
        <p>
          Personalised storybooks starring your child, in English or Hindi. Enable JavaScript
          to personalise your book and continue on WhatsApp. For support, email
          <a href="mailto:hello@bookmojo.in">hello@bookmojo.in</a>.
        </p>
      </div>
    </noscript>
  </body>
</html>