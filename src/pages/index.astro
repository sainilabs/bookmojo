---
import App from '@/App';
import '@/styles/global.css';
import { FAQS } from '@/data/faq';

const title = 'BookMojo — Personalised Storybooks Where Your Child Is the Hero';
const description =
  "The gift where your child is the hero: personalised storybooks built around their name, age and dream career, in English or Hindi. Order through WhatsApp.";
const canonical = new URL(Astro.url.pathname, Astro.site);
const asset = (path: string) => `${import.meta.env.BASE_URL}${path}`;

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'BookMojo Personalised Storybook',
  description,
  image: new URL(asset('hero-book.png'), Astro.site).href,
  brand: { '@type': 'Brand', name: 'BookMojo' },
  inLanguage: ['en-IN', 'hi-IN'],
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'INR',
    lowPrice: '199',
    highPrice: '1499',
    offerCount: '2',
    availability: 'https://schema.org/InStock',
    areaServed: { '@type': 'Country', name: 'India' },
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<!doctype html>
<html lang="en-IN" data-theme="day">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#fbfdfc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c1a17" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BookMojo" />
    <meta property="og:title" content="The gift where your child is the hero" />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(asset('og.svg'), Astro.site)} />
    <meta property="og:image:alt" content="BookMojo personalised storybooks" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={asset('favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@300..900&family=Literata:ital,opsz,wght@0,7..72,400..700;1,7..72,400..600&family=Mukta:wght@400;500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@300..900&family=Literata:ital,opsz,wght@0,7..72,400..700;1,7..72,400..600&family=Mukta:wght@400;500;600;700&display=swap"
    />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(productSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script is:inline>
      try {
        const stored = localStorage.getItem('bookmojo:theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = stored || (prefersDark ? 'night' : 'day');
      } catch {
        document.documentElement.dataset.theme = 'day';
      }
    </script>
  </head>
  <body>
    <App client:load />
    <noscript>
      <div style="padding: 2rem; font-family: sans-serif">
        <h1>BookMojo</h1>
        <p>
          Personalised storybooks starring your child, in English or Hindi. To order, message
          BookMojo on <a href="https://wa.me/919876543210">WhatsApp</a>.
        </p>
      </div>
    </noscript>
  </body>
</html>